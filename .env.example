# Required: Base URL of your deployment (must be HTTPS, no trailing slash)
BASE_URL=https://your-domain.com

# Required: Flask session signing key
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Required: Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ENABLED=true

# Required: Onshape OAuth (from Onshape developer portal)
ONSHAPE_CLIENT_ID=
ONSHAPE_CLIENT_SECRET=

# Optional: Restrict login to a Google Workspace domain
ALLOWED_DOMAINS=your-team-domain.com

# Optional: Allow specific emails regardless of domain
ALLOWED_EMAILS=

# Optional: Google Drive upload destination
DRIVE_NAME=Your Team Shared Drive
DRIVE_FOLDER=CNC/G-code

# Optional: Enable admin metrics endpoints (restricts access to this email)
ADMIN_EMAIL=admin@your-team-domain.com

# Optional
FLASK_ENV=production
